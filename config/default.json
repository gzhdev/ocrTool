{
  "ocr": {
    "model": "ppocrv6-small",
    "max_edge_px": 6000
  },
  "runtime": {
    "provider": "CPUExecutionProvider",
    "cpu_threads": 4
  },
  "logging": {
    "level": "INFO"
  },
  "ui": {
    "auto_copy": true,
    "show_boxes": false,
    "close_to_tray": false,
    "start_minimized": false,
    "tray_hint_done": false
  },
  "hotkey": {
    "capture": "Alt+Shift+A"
  },
  "system": {
    "auto_start": false
  }
}
